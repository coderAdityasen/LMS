# Copy to .env.local and fill in to use Supabase.
# Leave these unset to run in local demo mode (no account required).

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. Required only if you verify payment webhooks.
PAYMENT_WEBHOOK_SECRET=change-me

# Optional. Signs the local demo session cookie.
DEMO_SESSION_SECRET=change-me-in-production
